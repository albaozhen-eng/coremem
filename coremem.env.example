# 机器专属：复制为 coremem.env（已 gitignore）并改为本机真实值
MEMORY_HOME=$HOME/.coremem
MEM_DATA_DIR=$HOME/.coremem/data
MEM_SEMANTIC_BASE_URL=http://127.0.0.1:8089
MEM_SEMANTIC_GRAPH_ID=<your-graph-id>
MEM_SEMANTIC_API_KEY=
MEM_DAILY_NOTES_DIR=$HOME/.coremem/memory
MEM_MEMORY_MD=$HOME/.coremem/MEMORY.md
MEM_SESSIONS_DIR=$HOME/.coremem/sessions
MEM_BRIEFINGS_DIR=$HOME/.coremem/memory
