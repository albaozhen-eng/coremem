# 机器专属：复制为 coremem.env（已 gitignore）并改为本机真实值
MEMORY_HOME=$HOME/.openclaw
MEM_DATA_DIR=$HOME/.openclaw/data
MEM_SEMANTIC_BASE_URL=http://127.0.0.1:8089
MEM_SEMANTIC_GRAPH_ID=<your-graph-id>
MEM_SEMANTIC_API_KEY=
MEM_DAILY_NOTES_DIR=$HOME/.openclaw/workspace-main/memory
MEM_MEMORY_MD=$HOME/.openclaw/workspace-main/MEMORY.md
MEM_SESSIONS_DIR=$HOME/.openclaw/agents/main/sessions
MEM_BRIEFINGS_DIR=$HOME/.openclaw/workspace-main/memory
